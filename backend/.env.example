# ── Risk thresholds ──
LOW_RISK=40
HIGH_RISK=70
ALERT_THRESHOLD=80

# ── Server ──
PORT=5000
CORS_ORIGINS=*

# ── Transaction model ──
TXN_HIGH_PROB=0.65
TXN_MED_PROB=0.35

# ── Authentication (optional) ──
REQUIRE_AUTH=false
API_KEYS=admin:sk-trustvault-admin-key,readonly:sk-trustvault-read-key

# ── Alerts ──
ENABLE_ALERTS=true
ALERT_WEBHOOK_URL=
ALERT_DEDUP_WINDOW_SEC=60

# ── Database ──
DB_PATH=data/trustvault.db
